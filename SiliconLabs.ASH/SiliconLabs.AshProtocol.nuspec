<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <!-- Package ID is read from .csproj <PackageId> element -->
    <id>$id$</id>
    <version>$version$</version>
    <title>$title$</title>
    <authors>$authors$</authors>
    <owners>$authors$</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">$licenseExpression$</license>
    <projectUrl>$projectUrl$</projectUrl>
    <icon>icon.png</icon>
    <description>$description$</description>
    <releaseNotes>$releaseNotes$</releaseNotes>
    <copyright>$copyright$</copyright>
    <tags>$tags$</tags>
    <repository type="git" url="$repositoryUrl$" commit="$commit$" />
    <readme>README.md</readme>
    
    <!-- Dependencies are automatically determined from .csproj -->
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.Extensions.Logging" version="8.0.0" />
        <dependency id="System.IO.Ports" version="8.0.0" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Microsoft.Extensions.Logging" version="9.0.0" />
        <dependency id="System.IO.Ports" version="9.0.0" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.Extensions.Logging" version="10.0.0" />
        <dependency id="System.IO.Ports" version="10.0.0" />
      </group>
    </dependencies>
  </metadata>
  
  <files>
    <!-- README -->
    <file src="README.md" target="" />
    
    <!-- Icon (optional - uncomment if you have an icon) -->
    <!-- <file src="icon.png" target="" /> -->
    
    <!-- Libraries and symbols for all target frameworks -->
    <!-- These paths work regardless of project name -->
    <file src="bin\Release\**\*.dll" target="lib" />
    <file src="bin\Release\**\*.pdb" target="lib" />
    <file src="bin\Release\**\*.xml" target="lib" />
  </files>
</package>
